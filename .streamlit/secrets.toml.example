# 部署到 Streamlit Cloud 后，在网站后台 App → Settings → Secrets 里粘贴这些内容（换成真实值）
# 本地开发不用管这个文件，本地用项目根目录下的 .env 就行，两边配置项是一样的

DATABASE_URL = "postgresql://postgres:你的密码@你的host:5432/postgres"
APP_PASSWORD = "你和家人共用的密码"
OPENAI_API_KEY = "你的AI模型key"
OPENAI_BASE_URL = "https://api.deepseek.com/v1"
MODEL_NAME = "deepseek-chat"
