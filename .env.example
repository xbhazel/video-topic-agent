# 复制这个文件为 .env，然后填入你自己的配置
# cp .env.example .env

# ============ 数据库（Supabase 免费云数据库）============
# 去 supabase.com 建一个项目，在 Project Settings → Database → Connection string 里复制（选 URI 那种格式）
DATABASE_URL=postgresql://postgres:你的密码@你的host:5432/postgres

# ============ 密码门 ============
# 你和家人共用的密码，随便定一个
APP_PASSWORD=改成你自己的密码

# ============ AI 模型：方式一，OpenAI 官方（gpt-4o-mini，很便宜）============
OPENAI_API_KEY=your_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1
MODEL_NAME=gpt-4o-mini

# ============ AI 模型：方式二，DeepSeek（国内可直连，价格更低）============
# 取消下面三行的注释，并注释掉上面三行，即可切换
# OPENAI_API_KEY=your_deepseek_api_key
# OPENAI_BASE_URL=https://api.deepseek.com/v1
# MODEL_NAME=deepseek-chat

# ============ 其他 OpenAI 兼容模型同理 ============
# 只要服务商提供 "OpenAI 兼容接口"，改 BASE_URL 和 MODEL_NAME 就行，代码不用动
